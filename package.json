{
  "name": "@vivianhealth/braze-segment-debounce",
  "version": "0.0.0-development",
  "description": "Segment utilities to debounce data before it reaches the Braze destination",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "pretty": "prettier --write '{*,{src,docs,.github}/**/*,__{tests,mocks}__/**/*}.{json,md,yml,js}'",
    "fixcode": "npm run pretty",
    "semantic-release": "semantic-release",
    "release": "npm run semantic-release",
    "release-ci": "npm run semantic-release",
    "commit": "git-cz",
    "prepare": "husky",
    "clean": "rimraf index.js browser.js server.js lib",
    "build:only": "NODE_ENV=production babel src --out-dir .",
    "build": "npm run clean && npm run build:only",
    "prepack": "npm run build"
  },
  "repository": "https://github.com/nursefly/braze-segment-debounce",
  "author": "Andres Restrepo <andres@thelinuxkid.com>",
  "contributors": [
    {
      "name": "Brandon Phillips",
      "email": "bericp1@gmail.com"
    }
  ],
  "license": "MIT",
  "private": false,
  "files": [
    "lib",
    "eslint.config.js",
    ".gitignore",
    ".npmignore",
    ".prettierignore",
    ".prettierrc.json",
    "index.js",
    "server.js",
    "browser.js",
    "jest.config.js",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "devDependencies": {
    "@babel/cli": "^7.29.0",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "neostandard": "^0.14.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "semantic-release": "^25.0.9"
  },
  "engines": {
    "node": "^22.14.0 || >=24.10.0",
    "npm": "11.19.1"
  },
  "lint-staged": {
    "{*,{src,docs}/**/*,__{tests,mocks}__/**/*}.js": [
      "prettier --write",
      "eslint"
    ],
    "{*,{src,docs,.github}/**/*,__{tests,mocks}__/**/*}.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "keywords": [
    "Segment",
    "Braze"
  ],
  "dependencies": {}
}
